; Engine configuration file.
; Amethyst's VR start menu. Exported as a .pck and embedded in the Android app
; (see app_pojavlauncher's VRMenuActivity), it talks to the launcher through the
; "Amethyst" Java plugin (VRMenuPlugin).

config_version=5

[application]

config/name="Amethyst VR Menu"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/amlib/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
; No "no headset" popup when running on a PC
openxr/startup_alert=false
; Local floor: y=0 is the floor under the player, wherever the boundary is
openxr/reference_space=2
shaders/enabled=true
